--open source yet again
local highlights = {}
local billboardGuIs = {}

local highlights_v2 = {}
local billboardGuIs_v2 = {}

local function highlightPart(part, name)
    local highlight = Instance.new("Highlight")
    highlight.Parent = part
    highlight.FillColor = Color3.fromRGB(128, 0, 128) 
    highlight.OutlineColor = Color3.fromRGB(255, 0, 255) 
    highlight.FillTransparency = 0.5
    highlight.Enabled = true 

    local billboardGui = Instance.new("BillboardGui")
    billboardGui.Parent = part
    billboardGui.Adornee = part
    billboardGui.Size = UDim2.new(0, 100, 0, 25)
    billboardGui.StudsOffset = Vector3.new(0, 1, 0)
    billboardGui.AlwaysOnTop = true  
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Parent = billboardGui
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.Text = name
    textLabel.TextColor3 = Color3.fromRGB(255, 0, 255)
    textLabel.Font = Enum.Font.Code
    textLabel.TextScaled = true
    textLabel.BackgroundTransparency = 1
if name=="Medkit"then
    table.insert(highlights_v2, highlight)
    table.insert(billboardGuIs_v2, billboardGui)
    elseif name=="BloxyCola"then
    table.insert(highlights, highlight)
    table.insert(billboardGuIs, billboardGui)
    end
end

local function destroyAllHighlights(name)
if name=="BloxyCola"then
    for _, highlight in pairs(highlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end

    for _, billboardGui in pairs(billboardGuIs) do
        if billboardGui and billboardGui.Parent then
            billboardGui:Destroy()
        end
    end

    highlights = {}
    billboardGuIs = {}
    elseif name=="Medkit"then
    for _, highlight in pairs(highlights_v2) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end

    for _, billboardGui in pairs(billboardGuIs_v2) do
        if billboardGui and billboardGui.Parent then
            billboardGui:Destroy()
        end
    end
    highlights_v2 = {}
    billboardGuIs_v2 = {}
    end
end

local function ApplyHighlightToall(name) 
for _, descendant in pairs(game:GetDescendants()) do
    if descendant.Parent and descendant.Parent.Name == name then
        if descendant.Name == "ItemRoot" then
            if descendant:IsA("BasePart") then
                highlightPart(descendant, name)
            end
        end
    end
end
end

game.DescendantAdded:Connect(function(descendant)
    if descendant.Parent and descendant.Parent.Name == "BloxyCola" and BloxyCola_Esp_Actived then
        if descendant.Name == "ItemRoot" then
            if descendant:IsA("BasePart") then
                highlightPart(descendant, "BloxyCola")
            end
        end
    end
end)

game.DescendantAdded:Connect(function(descendant)
    if descendant.Parent and descendant.Parent.Name == "Medkit" and Medkit_Esp_Actived then
        if descendant.Name == "ItemRoot" then
            if descendant:IsA("BasePart") then
                highlightPart(descendant, "Medkit")
            end
        end
    end
end)


function Active_Highlight_ItemRoot(v, name)
if name=="Medkit" and v==true then
ApplyHighlightToall("Medkit")
Medkit_Esp_Actived=true
elseif name=="Medkit" and v==false then
Medkit_Esp_Actived=nil
destroyAllHighlights("Medkit")
end

if name=="BloxyCola" and v==true then
ApplyHighlightToall("BloxyCola")
BloxyCola_Esp_Actived=true
elseif name=="BloxyCola" and v==false then
BloxyCola_Esp_Actived=nil
destroyAllHighlights("BloxyCola")
end
end
